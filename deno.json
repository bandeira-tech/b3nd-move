{
  "name": "@bandeira-tech/b3nd-servers",
  "version": "0.12.0",
  "description": "B3nd Servers — server-side composition (createServers, withCors) and transports (HTTP, gRPC-HTTP) for the B3nd framework",
  "exports": {
    ".": "./mod.ts",
    "./http": "./libs/b3nd-server-http/mod.ts",
    "./grpc/http": "./grpc-http.ts",
    "./grpc/http/api": "./libs/b3nd-server-grpchttp/service.ts",
    "./grpc/http/server": "./libs/b3nd-server-grpchttp/mod.ts",
    "./grpc/http/client": "./libs/b3nd-client-grpchttp/mod.ts",
    "./grpc/proto": "./libs/b3nd-proto/mod.ts",
    "./mcp": "./mcp.ts",
    "./mcp/server": "./libs/b3nd-server-mcp/mod.ts",
    "./mcp/api": "./libs/b3nd-server-mcp/service.ts",
    "./ws": "./ws.ts",
    "./ws/server": "./libs/b3nd-server-ws/mod.ts",
    "./ws/api": "./libs/b3nd-server-ws/service.ts"
  },
  "imports": {
    "@bandeira-tech/b3nd-core": "jsr:@bandeira-tech/b3nd-core@^0.15.0",
"@std/assert": "jsr:@std/assert@^1.0.15",
    "@bufbuild/protobuf": "npm:@bufbuild/protobuf@^2.2.0",
    "@bufbuild/protobuf/codegenv2": "npm:@bufbuild/protobuf@^2.2.0/codegenv2",
    "@modelcontextprotocol/sdk/server/index.js": "npm:@modelcontextprotocol/sdk@^1.0.0/server/index.js",
    "@modelcontextprotocol/sdk/server/stdio.js": "npm:@modelcontextprotocol/sdk@^1.0.0/server/stdio.js",
    "@modelcontextprotocol/sdk/types.js": "npm:@modelcontextprotocol/sdk@^1.0.0/types.js"
  },
  "tasks": {
    "check": "deno check mod.ts grpc-http.ts mcp.ts ws.ts libs/b3nd-server-http/mod.ts libs/b3nd-server-grpchttp/mod.ts libs/b3nd-server-grpchttp/service.ts libs/b3nd-client-grpchttp/mod.ts libs/b3nd-proto/mod.ts libs/b3nd-server-mcp/mod.ts libs/b3nd-server-mcp/service.ts libs/b3nd-server-ws/mod.ts libs/b3nd-server-ws/service.ts libs/b3nd-testing/mod.ts",
    "test": "deno test --allow-all libs/",
    "build:npm": "deno run -A scripts/build-npm.ts"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable",
      "deno.ns"
    ]
  },
  "lint": {
    "exclude": ["libs/b3nd-proto/gen/", "npm/"]
  },
  "fmt": {
    "exclude": ["libs/b3nd-proto/gen/", "npm/"]
  },
  "publish": {
    "exclude": [
      "libs/b3nd-proto/buf.gen.yaml",
      "libs/b3nd-proto/buf.yaml",
      "libs/b3nd-proto/b3nd.proto",
      "libs/b3nd-testing/",
      "libs/**/*.test.ts",
      "libs/**/*_test.ts",
      "libs/**/README.md",
      "tests/",
      "node_modules/",
      "npm/",
      ".env*",
      "*.test.ts",
      "*.lock"
    ]
  }
}
