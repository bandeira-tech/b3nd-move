{
  "name": "@bandeira-tech/b3nd-grpc",
  "version": "0.9.4",
  "description": "B3nd gRPC — Connect-protocol client + server + wire schema for the B3nd framework",
  "exports": {
    ".": "./src/mod.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./proto": "./src/proto.ts"
  },
  "imports": {
    "@bandeira-tech/b3nd-core": "jsr:@bandeira-tech/b3nd-core@^0.9.4",
    "@std/assert": "jsr:@std/assert@^1.0.15"
  },
  "tasks": {
    "check": "deno check src/mod.ts",
    "test": "deno test --allow-all libs/"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable",
      "deno.ns"
    ]
  },
  "publish": {
    "exclude": [
      "libs/b3nd-proto/buf.gen.yaml",
      "libs/b3nd-proto/b3nd.proto",
      "libs/**/*.test.ts",
      "libs/**/*_test.ts",
      "libs/**/README.md",
      "libs/**/deno.json",
      "tests/",
      "node_modules/",
      ".env*",
      "*.test.ts",
      "*.lock"
    ]
  }
}
