{
  "name": "@bandeira-tech/b3nd-server-http",
  "version": "0.9.4",
  "description": "B3nd HTTP server — Hono-backed ServerResolver for serving a B3nd Rig over HTTP",
  "exports": {
    ".": "./src/mod.ts"
  },
  "imports": {
    "@bandeira-tech/b3nd-core": "jsr:@bandeira-tech/b3nd-core@^0.9.4",
    "@std/assert": "jsr:@std/assert@^1.0.15",
    "hono": "npm:hono@^4.6.0",
    "hono/cors": "npm:hono@^4.6.0/cors"
  },
  "tasks": {
    "check": "deno check src/mod.ts",
    "test": "deno test --allow-all libs/"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable",
      "deno.ns"
    ]
  },
  "publish": {
    "exclude": [
      "libs/**/*.test.ts",
      "libs/**/*_test.ts",
      "libs/**/README.md",
      "libs/**/deno.json",
      "tests/",
      "node_modules/",
      ".env*",
      "*.test.ts",
      "*.lock"
    ]
  }
}
